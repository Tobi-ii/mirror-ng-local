# Mirror.ng Environment Configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env && nano .env

# --- REQUIRED SECURITY KEYS ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-in-production

# Email password encryption key (separate from SECRET_KEY)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=change-me-in-production

# Admin API key (optional — required to use /api/admin/* endpoints)
ADMIN_KEY=your-admin-secret-key-here

# --- LLM API KEYS (required for Agent Chat & Insights) ---
OPENROUTER_API_KEY=your_openrouter_api_key
NVIDIA_API_KEY=your_nvidia_api_key

# --- GOOGLE OAUTH (optional — only needed for Gmail OAuth login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- DATABASE ---
DATABASE_URL=sqlite:///./data/mirror.db

# --- APP SETTINGS ---
CORS_ORIGINS=http://localhost:80,http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:80
DEBUG=false
