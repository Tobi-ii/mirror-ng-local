# ==============================================================================
# Mirror.ng Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# --- REQUIRED SECURITY KEYS ---

# 1. JWT signing secret (required)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_string_minimum_32_chars

# 2. Session middleware secret (required for OAuth state)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change_this_to_a_secure_random_string_minimum_32_chars

# 3. Email password encryption key — Fernet 32-byte urlsafe base64 (required)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=your-fernet-key-here

# 4. Admin API key (optional — required to use /api/admin/* endpoints)
ADMIN_KEY=your-admin-secret-key-here

# --- LLM API KEYS (For ML Transaction Insights / AI Assistant Chat) ---
OPENROUTER_API_KEY=your_openrouter_api_key
NVIDIA_API_KEY=your_nvidia_api_key
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- EMAIL PROVIDER OPTIONS ---
# Options: 'yahoo', 'gmail' (with App Password), or 'gmail_oauth' (via Google API)
EMAIL_PROVIDER=yahoo
YAHOO_EMAIL=your_email@yahoo.com
YAHOO_APP_PASSWORD=your_yahoo_app_password

# --- GOOGLE OAUTH CONFIGURATION (Required for "Login with Gmail" OAuth button) ---
# Set up a Web Application OAuth Client ID on Google Cloud Console:
# Redirect URI should be: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- DATABASE CONFIGURATION ---
DATABASE_URL=sqlite:///./mirror.db
DB_PATH=mirror.db
MODEL_PATH=category_model.pkl

# --- DATA RETENTION ---
# Number of days to keep transaction history (default 365)
RETENTION_DAYS=365

# --- APP SETTINGS ---
DEBUG=False
ENV=development
# CORS configuration (comma-separated origins allowed to talk to backend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Frontend callback URL for OAuth flow
FRONTEND_URL=http://localhost:3000

# --- SECURITY HARDENING ---
# Override the permissive default CSP (see SecurityHeadersMiddleware)
# CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';
# Set to "true" to enforce HTTPS-only cookies even in dev
# HTTPS_ONLY=false
